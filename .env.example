# Games Central — environment template.
# Copy to `.env.local` and fill in real values. NEVER commit a filled-in copy.
# Only NEXT_PUBLIC_-prefixed vars reach the browser; everything else is
# server-only. Do not add a NEXT_PUBLIC_ prefix to any secret below.

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# Use a least-privilege Atlas user (readWrite on this database only).
# Include the database name as a path segment — without one the driver
# silently connects to `test`:
#   mongodb+srv://USER:PASS@host.mongodb.net/gamescentral?retryWrites=true&w=majority
# Percent-encode any of : / ? # [ ] @ appearing in the password.
# Verify with `npm run db:check`.
DATABASE_URL=

# ---------------------------------------------------------------------------
# SmileOne  —  ⛔ THESE CREDENTIALS SPEND REAL MONEY
# ---------------------------------------------------------------------------
# The documented sandbox host (https://frontsmie.smile.one) does not exist in
# DNS. The only working host is production: https://www.smile.one — so any
# working configuration is a LIVE account holding real purchased diamonds.
# READ LIVE_ACCOUNT_SAFETY.md BEFORE USING THESE.
SMILEONE_API_BASE_URL=
SMILEONE_UID=
SMILEONE_EMAIL=
SMILEONE_KEY=

# ⛔ THE DELIVERY GATE. Leave EMPTY.
# Setting this to 1 is the single switch that allows a delivering endpoint
# (createorder) to be called, which spends the owner's diamonds irreversibly.
# Only the owner may set it, only after PayFast is wired and verified.
# Everything else — productlist and getrole — is read-only and always allowed.
SMILEONE_ALLOW_FULFILMENT=

# DEVELOPMENT ONLY. Set to 1 to stub account verification (getrole) with a
# generated in-game username. No longer needed — getrole works against the live
# account and only reads — so leave it empty: a fabricated name hides a broken
# lookup. Verification THROWS if this is set on a production build rather than
# returning a fabricated name — a real customer must never pay for delivery to
# an account nobody checked.
SMILEONE_STUB=

# ---------------------------------------------------------------------------
# PayFast Pakistan  (gopayfast.com — NOT payfast.co.za, a different company)
# ---------------------------------------------------------------------------
# Supplied by PayFast at go-live. While these are empty, checkout still creates
# real orders and simply tells the customer that online payment is not live —
# it does not pretend to charge anyone.
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_MODE=sandbox

# Optional override for the API host. The built-in sandbox/production hosts in
# lib/services/payfast/client.ts are UNCONFIRMED — set this once PayFast tells
# you the real one, rather than editing code.
PAYFAST_API_BASE_URL=

# Set to 1 ONLY after checking the hosted-checkout field names in
# lib/services/payfast/hosted-checkout.ts against PayFast's own documentation.
# Those names are a draft. With PAYFAST_MODE=production and this unset, the
# app refuses to build a redirect rather than sending customers to a payment
# page assembled from guesses.
PAYFAST_FIELDS_CONFIRMED=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Auth.js v5 session signing key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# AUTH_SECRET is the name Auth.js v5 reads; NEXTAUTH_SECRET is kept as the
# v4-compatible alias. Set both to the same value.
AUTH_SECRET=
NEXTAUTH_SECRET=
ADMIN_EMAIL=
# Shared secret for the product-sync cron endpoint. Generate the same way as
# NEXTAUTH_SECRET. Host-agnostic: works with Vercel Cron or a Hostinger crontab
# curl, so the production cutover does not change the code.
CRON_SECRET=
# Public origin, no trailing slash. e.g. https://gamescentral.pk
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Pricing — configurable, never hardcoded (Section 10)
# ---------------------------------------------------------------------------
# Percentage markup applied on top of the converted base price, e.g. 20 = +20%.
DEFAULT_MARKUP_PERCENTAGE=
USD_TO_PKR_RATE=

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
# Set to 1 only for the self-hosted (Hostinger) production build to emit
# .next/standalone. Leave unset for Vercel previews and local dev.
BUILD_STANDALONE=

# ---------------------------------------------------------------------------
# Optional — add when the features land
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
# UPSTASH_REDIS_URL=
